{
  "name": "devcroft — Linux/Landlock",
  "build": { "dockerfile": "Dockerfile" },

  // Landlock itself needed no security-opt relaxation: creating a ruleset
  // is an unprivileged operation, verified to work here under the default
  // seccomp profile (ABI 8). If a host's runtime does block the landlock_*
  // syscalls, spike-doctor reports EPERM and names the flag to add — better
  // than shipping a permanently weakened container for a problem this host
  // does not have.
  //
  // `seccomp=unconfined` below was added for the hardened tier
  // (add-gvisor-backend), which `remove-gvisor-backend` has now deleted.
  // **It is deliberately kept, and that needs justifying rather than
  // assuming**, because the tier it was added for is gone:
  //
  //   - What it buys: unprivileged user-namespace creation
  //     (`CLONE_NEWUSER`). The container runtime's default seccomp profile
  //     (moby/moby's `default.json`) blocks the flag with EPERM unless the
  //     caller holds `CAP_SYS_ADMIN` in its *effective* set, which a
  //     non-root `remoteUser` never does — capabilities reach a non-root
  //     process only via file capabilities or by running as root, so
  //     `--cap-add=SYS_ADMIN` alone does not help. Confirmed directly via
  //     `/proc/self/status`, not inferred: this is not the Debian
  //     `kernel.unprivileged_userns_clone` sysctl, which does not exist on
  //     this kernel.
  //   - Why keep it: `add-linux-agent-fleet` builds net/pid/ipc/uts/mount
  //     namespaces directly, which needs exactly this. Removing the flag
  //     now would restore the container's default confinement and then
  //     have to be undone for that change.
  //   - The honest cost: nothing in the tree needs it *today*. The process
  //     tier's Landlock needs no relaxation at all — that was verified
  //     under the default profile. So this is a weakened container held
  //     open for future work, which is a real trade, not a free one.
  //
  // Worth revisiting if fleet is deferred or dropped: the narrower
  // alternative is granting the specific binary file capabilities rather
  // than unconfining the whole container.
  //
  // **Confirmed by fleet's D5 spike:** unprivileged `user`+`net`
  // namespaces do work here, so the justification above holds up — two
  // simulated agents were shown binding the same loopback port without
  // colliding, using nothing but `unshare` and `ip link set lo up`.
  //
  // **A second prerequisite that spike found, deliberately NOT added
  // here yet:** fleet's *egress* path (pasta or slirp4netns, D5) needs
  // `/dev/net/tun`, and this container has no `/dev/net` at all — both
  // candidates fail with `open("/dev/net/tun"): No such file or
  // directory`, so the D5 comparison cannot be run until the device is
  // passed through (`--device /dev/net/tun`). Left out on purpose: it is
  // another standing relaxation for work that has not started, the same
  // trade this comment argues has a real cost, and the in-namespace
  // service-port half of fleet does not need it. Add it when the D5
  // spike actually resumes, not before.
  "runArgs": ["--security-opt", "seccomp=unconfined"],

  // Fails loudly if Landlock is not reachable, instead of letting the spike
  // report a confinement result that the kernel never enforced. Also
  // installs the OpenSpec CLI (openspec.dev workflow this repo is driven
  // by, per CLAUDE.md) — it needs Node, which only exists once the node
  // feature below has applied, so it can't live in the Dockerfile itself.
  "postCreateCommand": "spike-doctor && npm install -g @fission-ai/openspec@latest",

  // flox (task 3.2) needs nix-daemon running; there is no systemd here to
  // supervise it, and it does not persist across container restarts, so
  // start it explicitly on every boot. The `status` check keeps repeated
  // starts quiet instead of erroring on an already-running daemon.
  "postStartCommand": "sudo service nix-daemon status >/dev/null 2>&1 || sudo service nix-daemon start",

  "remoteUser": "vscode",

  // The claude-code feature can bootstrap Node itself, but only best-effort
  // and at 18.x; its own NOTES.md recommends declaring Node explicitly, which
  // also keeps the version a decision rather than a fallback. Both are pinned
  // for the same reason nono is: an image that drifts between rebuilds cannot
  // support a spike whose whole output is "this worked at these versions".
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },

  // Keeps the login and session history across rebuilds. A named volume
  // rather than a bind mount of the host's ~/.claude: the container gets its
  // own credentials instead of read access to the host's.
  "mounts": [
    "source=devcroft-claude-home,target=/home/vscode/.claude,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"],
      "settings": { "rust-analyzer.check.command": "clippy" }
    }
  }
}
