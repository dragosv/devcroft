+                let count = bytes.len().min(STDIN_CHUNK_BYTES - last.bytes.len());
+                last.bytes.extend_from_slice(&bytes[..count]);
+                bytes = &bytes[count..];
+            } else {
+                let count = bytes.len().min(STDIN_CHUNK_BYTES);
