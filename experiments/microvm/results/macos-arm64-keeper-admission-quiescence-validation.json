  "shared_keeper_changes": [
    "1 s monotonic deadline for the first Spawn/Query frame and for completing any later frame once its tag arrives; idle established sessions are not timed out",
    "per-tag caps: Stdin/Stdout/Stderr/QueryResult 16 MiB, Spawn 4 MiB (above macOS/Linux ARG_MAX), other control frames 64 KiB; payload buffers grow as bytes arrive from a 64 KiB reservation",
    "at most 16 simultaneous keeper connections; the 17th gets SpawnErr 'keeper connection limit exceeded' at accept"
  ],
  "guest_changes": [
    "guest relay: at most 24 simultaneous transport relays",
    "PID 1 control socket: 1 s per-connection line deadline, 512-command bound, drained close after refusal",
    "orderly stop: TERM then KILL every child, unmount workspace/toolchain (EBUSY retried), then sync and ack; a failed unmount answers ERR shutdown-busy instead of acknowledging"
  ],
  "excluded_runs": [
